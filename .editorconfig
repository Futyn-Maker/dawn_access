root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.ini]
indent_size = 2

# The mod's settings and language tables begin with a byte order mark, which the game's UE4SS and the
# mod's reader both expect; an editor must keep it.
[mod/**.ini]
charset = utf-8-bom
